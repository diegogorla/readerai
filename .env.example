# ==============================================================
# Reader AI - Environment Configuration Guide
# ==============================================================

# Google Gemini API Key for smart summaries, translation, and Gemini TTS / transcription
GEMINI_API_KEY=

# ElevenLabs API Key for high-fidelity custom and cloned voice synthesis (Dgorla voice)
ELEVENLABS_API_KEY=

# OpenAI API Key for OpenAI TTS (alloy, echo, nova, etc.) and Whisper audio transcription
OPENAI_API_KEY=

# Google OAuth Credentials (stored securely server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================
# Paddle Billing v2 (PaddleHQ/paddle-agent-skills standard)
# ==============================================================
# Client-side token for Paddle.js checkout overlay
VITE_PADDLE_CLIENT_TOKEN=test_token_readerai

# Server-side API key for Paddle Billing API and customer portal session minting
PADDLE_API_KEY=

# Secret key for HMAC-SHA256 paddle-signature webhook verification
PADDLE_WEBHOOK_SECRET_KEY=

# Environment: 'sandbox' for testing (with test cards) or 'production'
PADDLE_ENVIRONMENT=sandbox

# Paddle Billing Product / Price IDs
PADDLE_PRICE_ID_MONTHLY=pri_readerai_monthly_brl
PADDLE_PRICE_ID_ANNUAL=pri_readerai_annual_brl
PADDLE_PRICE_ID_LIFETIME=pri_readerai_lifetime_brl

# RevenueCat Configuration (for iOS App Store deployment via Expo)
REVENUECAT_API_KEY=

# ==============================================================
# SMTP Email Settings (100% OPCIONAL / NÃO OBRIGATÓRIO)
# ==============================================================
# Se você NÃO tem SMTP, o sistema funciona perfeitamente:
# O código 2FA é gerado com segurança pelo servidor e preenchido
# automaticamente na tela de login, permitindo acesso com 1 clique.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@readerai.app

# Server Port
PORT=3000
